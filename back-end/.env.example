# Copy to .env (git-ignored) and fill in, then run `make seed-user-dry-run` / `make seed-user`.
SEED_USER_NAME="Gabriel"
SEED_USER_EMAIL="gabriel@example.com"
# 8 to 72 bytes. Quote it if it has spaces or shell characters.
SEED_USER_PASSWORD="change-me-please"
# Id of an existing guild the new user joins. `familia` is created by migration 0004.
SEED_USER_GUILD="familia"

# Optional: defaults to the docker-compose database.
# DATABASE_URL="postgres://boraquest:boraquest@localhost:5432/boraquest?sslmode=disable"

# Required by `make fly-secrets` (production only, never the dev default): openssl rand -base64 48
# JWT_SECRET=""

# Required by `make run` / `make dev`: Cloudinary account that stores quest proof photos
# (dashboard → API Keys). The API refuses to start without all three.
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""

# Required by `make run` / `make dev` and `make fly-secrets`: the daily reminder's Web Push keys.
# Generate the VAPID pair once (`npx web-push generate-vapid-keys`) and never rotate it casually:
# every existing browser subscription is tied to the public key. VAPID_SUBJECT must be a real
# contact as a full `mailto:` (no spaces or angle brackets) or an https URL; Apple rejects
# anything else. The API refuses to start without all four.
VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
VAPID_SUBJECT="mailto:you@example.com"
# Shared with the GitHub `production` environment secret of the same name: openssl rand -base64 32
REMINDER_CRON_SECRET=""
